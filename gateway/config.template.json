{
    "listeners": [
        {
            "address": "0.0.0.0",
            "port": 8080,
            "https": false
        }
    ],
    "db_clients": [
        {
            "name": "default",
            "rdbms": "postgresql",
            "host": "127.0.0.1",
            "port": 5432,
            "dbname": "${POSTGRES_NAME}",
            "user": "${POSTGRES_USER}",
            "passwd": "${POSTGRES_PASSWORD}",
            "is_fast": false,
            "connection_number": 10
        }
    ],
    "app": {
        "number_of_threads": 0,
        "client_max_body_size": "50M",
        "run_as_daemon": false,
        "recreate_database_on_start": false,
        "log": {
            "log_path": "./logs",
            "logfile_base_name": "eventflow_gateway",
            "log_size_limit": 10000000,
            "log_level": "DEBUG"
        }
    }
}